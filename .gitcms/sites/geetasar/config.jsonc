{
  "version": "1.2",
  "media": {
    "default_library": "repo_media",
    "libraries": [
      {
        "key": "repo_media",
        "label": "Repository media",
        "references": {
          "write": {
            "mode": "root_relative",
            "base_path": "/"
          },
          "allow_default_library_fallback": true
        },
        "limits": {
          "max_file_size_mb": 10
        },
        "driver": "git",
        "storage": {
          "root_path": "public"
        }
      }
    ]
  },
  "ssg_framework": "astro",
  "frontmatter_format": "toml",
  "sitemap_url": "https://geetasar.com/sitemap.xml",
  "publishing_mode": "direct_publish",
  "i18n": {
    "enabled": true,
    "locales": [
      "en",
      "hi"
    ],
    "default_locale": "en",
    "prefix_default_locale": true
  },
  "collections": [
    {
      "name": "docs",
      "git_path": "/docs/",
      "file_extension": ".md",
      "filename_pattern": "",
      "label": "Shlok",
      "collection_type": "flat",
      "i18n": {
        "enabled": true,
        "strategy": "path"
      }
    }
  ]
}
